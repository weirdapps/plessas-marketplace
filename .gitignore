# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Build artefacts
dist/
build/
*.egg-info/

# Playwright MCP debug artifacts (console logs, page snapshots) — scratch output
.playwright-mcp/

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# User-generated databases (must NEVER ship — schema-only templates allowed)
*.db
*.db-journal
*.sqlite
*.sqlite3

# Schema templates may be committed if explicitly named *.schema.sql or *.schema.db
!*.schema.db

# User-generated style guide (written by /style-rebuild — contains PII: names,
# emails, phone numbers, per-recipient profiles). The committed file is the
# sanitised EXAMPLE: plugins/mail/shared/style-guide-example.md
plugins/mail/shared/style-guide.md

# Local plugin overrides
.local.md
*.local.md

# Backups
*.bak
*.backup
*.backup-*

# Local memory / session logs (never commit)
.remember/

# Claude Code plugin cache (auto-generated at marketplace root)
/chat/[0-9]*/
/decks/[0-9]*/
/excel/[0-9]*/
/mail/[0-9]*/
/meetings/[0-9]*/
/docs/[0-9]*/

# CLI dependencies cloned by install.sh (outlook-access, teams-access, …).
# These are upstream repos auto-fetched on install — never commit them here.
/installers/deps/

# Secrets. A bare `.env` line does not cover `.env.bak-*`, `.env.local` or
# `.env.production`; a rotation script.s timestamped backup was staged into a
# public repo through exactly that gap. Keep the rule in the repo rather than
# in a global ignore file, which is machine-local and protects neither a fresh
# clone nor CI nor the VPS copy.
.env.*

# Coverage artefacts. `.coverage` is a file and `htmlcov/` a directory,
# so both forms are needed; a bare `htmlcov` would not match the directory.
.coverage
.coverage.*
htmlcov/
