# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Build artefacts
dist/
build/
*.egg-info/

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# User-generated databases (must NEVER ship — schema-only templates allowed)
*.db
*.db-journal
*.sqlite
*.sqlite3

# Schema templates may be committed if explicitly named *.schema.sql or *.schema.db
!*.schema.db

# Local plugin overrides
.local.md
*.local.md

# Backups
*.bak
*.backup

# Local memory / session logs (never commit)
.remember/

# Claude Code plugin cache (auto-generated at marketplace root)
/chat/[0-9]*/
/decks/[0-9]*/
/excel/[0-9]*/
/mail/[0-9]*/
/meetings/[0-9]*/
/docs/[0-9]*/
